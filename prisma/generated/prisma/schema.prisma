generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Key {
  E_MAJOR
  A_MAJOR
  D_MAJOR
  C_MAJOR
  G_MAJOR
  A_MINOR
  E_MINOR
  D_MINOR
  B_MAJOR
  F_MAJOR
  Bb_MAJOR
  Eb_MAJOR
  Ab_MAJOR
  Db_MAJOR
  Gb_MAJOR
  B_MINOR
  F_SHARP_MINOR
  C_SHARP_MINOR
  G_MINOR
  C_MINOR
  F_MINOR
  Bb_MINOR
}

enum Tuning {
  STANDARD
  DROP_D
  DROP_C
  OPEN_G
  OPEN_D
  DADGAD
}

enum ThumbStyle {
  STEADY
  ALTERNATING
}

enum SongStatus {
  LEARNING
  MAINTENANCE
  WRITING
  RECORDING
  MIXING
  STALLED
  RELEASED
}

model Song {
  id             String      @id @default(cuid())
  userId         String
  title          String
  key            Key?
  capo           Int? //fret number, null means no capo
  tuning         Tuning      @default(STANDARD)
  thumbStyle     ThumbStyle?
  status         SongStatus  @default(LEARNING)
  currentBlocker String?
  createdAt      DateTime    @default(now())
  sessions       Session[]

  @@unique([userId, title])
}

model Tag {
  id       String    @id @default(cuid())
  userId   String
  name     String
  sessions Session[]

  @@unique([userId, name])
}

model Recording {
  id        String   @id @default(cuid())
  sessionId String
  url       String
  label     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Instructor {
  id        String    @id @default(cuid())
  userId    String
  name      String
  sessions  Session[]
  createdAt DateTime  @default(now())

  @@unique([userId, name])
}

model Goal {
  id        String    @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime  @default(now())
  sessions  Session[]

  @@unique([userId, name])
}

model SessionTemplate {
  id             String    @id @default(cuid())
  userId         String
  name           String
  showMetronome  Boolean   @default(false)
  showSongPicker Boolean   @default(true)
  showGoalPicker Boolean   @default(false)
  checklistItems Json?
  createdAt      DateTime  @default(now())
  sessions       Session[]

  @@unique([userId, name])
}

model Session {
  id               String           @id @default(cuid())
  userId           String
  date             DateTime         @default(now())
  duration         Int
  topic            String?
  notes            String?
  bpm              Int?
  instrument       String?
  intention        String? // set before practicing
  intentionMet     Boolean?
  mood             Int?
  focus            Int?
  isFavorited      Boolean          @default(false)
  isPublic         Boolean          @default(false)
  songId           String?
  song             Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  tags             Tag[]
  recordings       Recording[]
  instructorId     String?
  instructor       Instructor?      @relation(fields: [instructorId], references: [id])
  goalId           String?
  goal             Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pickup           String? // where to pick up next time
  templateId       String?
  template         SessionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  checklistAnswers Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

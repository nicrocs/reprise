generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tuning {
  STANDARD
  DROP_D
  DROP_C
  OPEN_G
  OPEN_D
  DADGAD
}

model Song {
  id        String    @id @default(cuid())
  userId    String
  title     String
  tuning    Tuning    @default(STANDARD)
  createdAt DateTime  @default(now())
  sessions  Session[]

  @@unique([userId, title])
}

model Tag {
  id       String    @id @default(cuid())
  userId   String
  name     String
  sessions Session[]

  @@unique([userId, name])
}

model Recording {
  id        String   @id @default(cuid())
  sessionId String
  url       String
  label     String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Instructor {
  id        String    @id @default(cuid())
  userId    String
  name      String
  sessions  Session[]
  createdAt DateTime  @default(now())

  @@unique([userId, name])
}

model Session {
  id           String      @id @default(cuid())
  userId       String
  date         DateTime    @default(now())
  duration     Int
  topic        String
  notes        String?
  bpm          Int?
  instrument   String?
  mood         Int?
  focus        Int?
  isFavorited  Boolean     @default(false)
  isPublic     Boolean     @default(false)
  songId       String?
  song         Song?       @relation(fields: [songId], references: [id])
  tags         Tag[]
  recordings   Recording[]
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

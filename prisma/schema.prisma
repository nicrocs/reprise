generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tuning {
  STANDARD
  DROP_D
  DROP_C
  OPEN_G
  OPEN_D
  DADGAD
}

model Song {
  id        String   @id @default(cuid())
  userId    String
  title     String
  tuning    Tuning   @default(STANDARD)
  createdAt DateTime @default(now())
  sessions  Session[]

  @@unique([userId, title])
}

model Tag {
  id       String    @id @default(cuid())
  userId   String
  name     String
  sessions Session[]

  @@unique([userId, name])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  duration  Int
  topic     String
  notes     String?
  bpm       Int?
  songId    String?
  song      Song?    @relation(fields: [songId], references: [id])
  tags     Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
